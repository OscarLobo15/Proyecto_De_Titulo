{% if include_login %}
import { LogOut } from 'lucide-react';
import { useAuth } from '../../context/AuthContext.jsx';
{% endif %}

export function Header() {
{% if include_login %}
  const { user, logout } = useAuth();
{% endif %}

  return (
    <header className="topbar">
      <div className="topbar-title">
        <span className="eyebrow">{{ project_title }}</span>
        <h1>Workspace operativo</h1>
      </div>
      <div className="ibm-wordmark" aria-label="IBM">IBM</div>
{% if include_login %}
      <div className="user-menu">
        <span>{user?.email || user?.displayName || 'Usuario'}</span>
        <button className="icon-button" type="button" onClick={logout} title="Cerrar sesión">
          <LogOut size={16} />
        </button>
      </div>
{% endif %}
    </header>
  );
}
