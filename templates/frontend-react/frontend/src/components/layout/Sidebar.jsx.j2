import { BarChart3, Bot, Cpu, FolderKanban, Layers, PanelLeft, Settings, Users } from 'lucide-react';
import { NavLink } from 'react-router-dom';
{% if include_login %}
import { useAuth } from '../../context/AuthContext.jsx';
{% endif %}

export function Sidebar() {
  const modules = {{ modules | tojson }};
  const navigationSections = {{ navigation_sections | tojson }};
{% if include_login %}
  const { user } = useAuth();
{% endif %}

  return (
    <aside className="sidebar sidebar--{{ experience_mode }}">
      <div className="sidebar-inner">
        <div className="brand">
          <img className="brand-logo" src="/ibm-logo.png" alt="IBM" />
          <div>
            <span className="eyebrow">{{ experience_mode }}</span>
            <span className="brand-name">{{ project_title }}</span>
          </div>
        </div>
        <nav>
          <NavLink to="/app/workspace">
            <PanelLeft size={16} />
            Workspace
          </NavLink>

          <NavLink to="/app/dashboard">
            <BarChart3 size={16} />
            {{ "Panel admin" if experience_mode == "admin" else "Administración" }}
          </NavLink>

          {navigationSections.length > 0 && (
            <div className="nav-section">
              <div className="nav-label">Apartados</div>
              {navigationSections.map((section) => (
                <NavLink key={section.slug} to={`/app/module/${section.slug}`}>
                  <FolderKanban size={16} />
                  {section.label}
                </NavLink>
              ))}
            </div>
          )}

          <div className="nav-section">
            <div className="nav-label">Módulos</div>
            {modules.map((module) => (
              <NavLink key={module.slug} to={`/app/module/${module.slug}`}>
                <Layers size={16} />
                {module.label}
              </NavLink>
            ))}
          </div>
{% if include_services and extra_services %}

          <div className="nav-section">
            <div className="nav-label">Servicios</div>
{% for service in extra_services %}
            <NavLink to="/app/service/{{ service.slug }}">
              <Cpu size={16} />
              {{ service.name }}
            </NavLink>
{% endfor %}
          </div>
{% endif %}
{% if include_ai_ui %}

          <div className="nav-section">
            <div className="nav-label">IA</div>
            <NavLink to="/app/agent">
              <Bot size={16} />
              Agente
            </NavLink>
          </div>
{% endif %}

          <div className="nav-section">
            <NavLink to="/app/settings">
              <Settings size={16} />
              Configuración
            </NavLink>
          </div>
        </nav>
      </div>

      <div className="sidebar-footer">
        <div className="sidebar-avatar">
          <Users size={16} />
        </div>
        <div className="sidebar-user-copy">
{% if include_login %}
          <strong>{user?.displayName || user?.email || '{{ experience_mode }}'}</strong>
          <span>{user?.email || 'workspace@ibm.com'}</span>
{% else %}
          <strong>{{ experience_mode | title }}</strong>
          <span>workspace@ibm.com</span>
{% endif %}
        </div>
      </div>
    </aside>
  );
}
