import { Activity, Database, Layers, Server, ShieldCheck } from 'lucide-react';
import { useEffect, useState } from 'react';
{% if has_backend %}
import { getHealth } from '../services/api.js';
{% endif %}

export function Workspace() {
  const modules = {{ modules | tojson }};
  const roles = {{ role_labels | tojson }};
  const [apiStatus, setApiStatus] = useState('checking');

  useEffect(() => {
{% if has_backend %}
    getHealth()
      .then((response) => setApiStatus(response.status))
      .catch(() => setApiStatus('offline'));
{% else %}
    setApiStatus('frontend-only');
{% endif %}
  }, []);

  return (
    <div className="page-stack">
      <div className="page-header">
        <span className="eyebrow">{{ project_profile }}</span>
        <h2>{{ project_title }}</h2>
        <p>{{ description }}</p>
      </div>

      <div className="metrics-grid">
        <div className="card">
          <Activity size={20} className="card-icon" />
          <span className="card-label">Estado API</span>
          <strong className="card-value">{apiStatus}</strong>
        </div>
        <div className="card">
          <Layers size={20} className="card-icon" />
          <span className="card-label">Perfil</span>
          <strong className="card-value">{{ project_profile }}</strong>
        </div>
{% if has_backend %}
        <div className="card">
          <Server size={20} className="card-icon" />
          <span className="card-label">Backend</span>
          <strong className="card-value">{{ project.backend }}</strong>
        </div>
        <div className="card">
          <Database size={20} className="card-icon" />
          <span className="card-label">Datos</span>
          <strong className="card-value">{{ project.database }}</strong>
        </div>
{% endif %}
{% if include_login %}
        <div className="card">
          <ShieldCheck size={20} className="card-icon" />
          <span className="card-label">Acceso</span>
          <strong className="card-value">{{ project.auth }}</strong>
        </div>
{% else %}
        <div className="card">
          <ShieldCheck size={20} className="card-icon" />
          <span className="card-label">Acceso</span>
          <strong className="card-value">publico</strong>
        </div>
{% endif %}
{% if include_services %}
        <div className="card">
          <Server size={20} className="card-icon" />
          <span className="card-label">Servicios</span>
          <strong className="card-value">{{ service_count }}</strong>
        </div>
{% endif %}
      </div>

      <section className="module-grid" aria-label="Módulos del proyecto">
        {modules.map((module) => (
          <article className="module-card" key={module.slug}>
            <Layers size={18} className="card-icon" />
            <span>{module.slug}</span>
            <h3>{module.label}</h3>
            <p>Base funcional preparada para extender esta parte del producto.</p>
          </article>
        ))}
      </section>

      <section className="settings-panel">
        <dl className="settings-list">
          <div>
            <dt>Navegación</dt>
            <dd>{{ navigation_layout }}</dd>
          </div>
          <div>
            <dt>Acceso</dt>
            <dd>{{ "admin directo" if experience_mode == "admin" else "portal + admin" }}</dd>
          </div>
          <div>
            <dt>Panel admin</dt>
            <dd>{{ "operations workspace" if admin_style == "operations" else "business control" }}</dd>
          </div>
{% if include_login %}
          <div>
            <dt>Login</dt>
            <dd>{{ "editorial" if login_variant == "ibm-classic" else "operations console" if login_variant == "digital-workers" else "client portal" }}</dd>
          </div>
{% endif %}
          <div>
            <dt>Cloud</dt>
            <dd>{{ cloud_label }}</dd>
          </div>
          <div>
            <dt>Roles</dt>
            <dd>{roles.join(', ')}</dd>
          </div>
          <div>
            <dt>Contenedores</dt>
            <dd>{{ containers | join(", ") }}</dd>
          </div>
          <div>
            <dt>Scripts</dt>
            <dd>{{ "dev.sh / setup.sh" if include_dev_script else "sin script local" }}</dd>
          </div>
        </dl>
      </section>
    </div>
  );
}
