import { Layers{% if experience_mode == "admin" %}, Plus{% endif %} } from 'lucide-react';
import { useEffect, useState } from 'react';
import { Link } from 'react-router-dom';
{% if has_backend and modules %}
import {
  getHealth,
{% for module in modules %}
{% set camel = module.slug.split('-') | map('capitalize') | join('') %}
  get{{ camel }}Items,
{% endfor %}
} from '../services/api.js';
{% elif has_backend %}
import { getHealth } from '../services/api.js';
{% endif %}

{% if has_backend and modules %}
const MODULE_LOADERS = {
{% for module in modules %}
{% set camel = module.slug.split('-') | map('capitalize') | join('') %}
  '{{ module.slug }}': get{{ camel }}Items,
{% endfor %}
};
{% endif %}

const MODULES = {{ modules | tojson }};

export function Workspace() {
{% if has_backend %}
  const [apiStatus, setApiStatus] = useState('checking');
{% endif %}
{% if has_backend and modules %}
  const [counts, setCounts] = useState({});
{% endif %}

  useEffect(() => {
{% if has_backend %}
    getHealth()
      .then((r) => setApiStatus(r.status ?? 'ok'))
      .catch(() => setApiStatus('offline'));
{% endif %}
{% if has_backend and modules %}
    const slugs = MODULES.map((m) => m.slug);
    Promise.allSettled(slugs.map((slug) => MODULE_LOADERS[slug]())).then((results) => {
      const next = {};
      results.forEach((r, i) => {
        next[slugs[i]] = r.status === 'fulfilled' ? r.value.length : '—';
      });
      setCounts(next);
    });
{% endif %}
  }, []);

  return (
    <div className="page-stack">
      <div className="page-header">
        <span className="eyebrow">{{ project_profile }}</span>
        <h2>{{ project_title }}</h2>
        <p>{{ description }}</p>
      </div>

{% if admin_style == "business" %}
      <div className="kpi-bar">
{% if has_backend %}
        <div className="kpi-card">
          <span className="kpi-label">API</span>
          <span className="kpi-value">{apiStatus}</span>
        </div>
{% endif %}
        <div className="kpi-card">
          <span className="kpi-label">Módulos</span>
          <span className="kpi-value">{{ modules | length }}</span>
        </div>
{% if include_services %}
        <div className="kpi-card">
          <span className="kpi-label">Servicios</span>
          <span className="kpi-value">{{ service_count }}</span>
        </div>
{% endif %}
        <div className="kpi-card">
          <span className="kpi-label">Roles</span>
          <span className="kpi-value">{{ role_labels | length }}</span>
        </div>
      </div>

      <section className="module-grid" aria-label="Módulos">
        {MODULES.map((m) => (
          <article className="module-card" key={m.slug}>
            <Layers size={18} className="card-icon" />
            <h3>{m.label}</h3>
{% if has_backend %}
            <p className="kpi-value">{counts[m.slug] ?? '…'} registros</p>
{% endif %}
            <div className="card-actions">
              <Link to={`/app/module/${m.slug}`} className="btn-primary">
{% if experience_mode == "admin" %}
                Gestionar
{% else %}
                Ver
{% endif %}
              </Link>
            </div>
          </article>
        ))}
      </section>

{% else %}
      <section className="module-table-section" aria-label="Módulos">
{% if has_backend %}
        <p className="api-status">API: {apiStatus}</p>
{% endif %}
        <table className="data-table">
          <thead>
            <tr>
              <th>Módulo</th>
{% if has_backend %}
              <th>Registros</th>
{% endif %}
              <th aria-label="acciones" />
            </tr>
          </thead>
          <tbody>
            {MODULES.map((m) => (
              <tr key={m.slug}>
                <td>
                  <Layers size={14} className="card-icon" />
                  {m.label}
                </td>
{% if has_backend %}
                <td>{counts[m.slug] ?? '…'}</td>
{% endif %}
                <td className="row-actions">
                  <Link to={`/app/module/${m.slug}`} className="btn-ghost">
{% if experience_mode == "admin" %}
                    Gestionar
{% else %}
                    Ver
{% endif %}
                  </Link>
{% if experience_mode == "admin" %}
                  <Link to={`/app/module/${m.slug}`} className="btn-primary">
                    <Plus size={14} /> Nuevo
                  </Link>
{% endif %}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
{% endif %}
    </div>
  );
}
