import { useState, useEffect } from 'react';
import { useParams } from 'react-router-dom';
{% if has_backend and modules %}
import {
{% for module in modules %}
{% set camel = module.slug.split('-') | map('capitalize') | join('') %}
  get{{ camel }}Items,
  create{{ camel }}Item,
  update{{ camel }}Item,
  delete{{ camel }}Item,
{% endfor %}
} from '../services/api';
{% endif %}

const MODULE_META = {
{% for module in modules %}
  '{{ module.slug }}': { label: '{{ module.label }}' },
{% endfor %}
};

{% if has_backend and modules %}
// TODO: Replace stub field lists with your actual per-module schema fields
const MODULE_SCHEMAS = {
{% for module in modules %}
  '{{ module.slug }}': ['nombre', 'descripcion'],
{% endfor %}
};

const moduleApi = {
{% for module in modules %}
{% set camel = module.slug.split('-') | map('capitalize') | join('') %}
  '{{ module.slug }}': {
    list: get{{ camel }}Items,
    create: create{{ camel }}Item,
    update: update{{ camel }}Item,
    remove: delete{{ camel }}Item,
  },
{% endfor %}
};
{% endif %}

export function ModulePage() {
  const { moduleSlug } = useParams();
  const meta = MODULE_META[moduleSlug] || { label: moduleSlug };
{% if has_backend and modules %}
  const api = moduleApi[moduleSlug];
  const schemaFields = MODULE_SCHEMAS[moduleSlug] ?? ['nombre'];

  const [items, setItems] = useState([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
{% if experience_mode == "admin" %}
  const [showForm, setShowForm] = useState(false);
  const [editingItem, setEditingItem] = useState(null);
  const [formData, setFormData] = useState({});
{% endif %}

  useEffect(() => {
    if (!api) return;
    setLoading(true);
    setError(null);
    api.list()
      .then(setItems)
      .catch((err) => setError(err?.message ?? 'Error cargando datos'))
      .finally(() => setLoading(false));
  }, [moduleSlug]);

{% if experience_mode == "admin" %}
  const openCreate = () => {
    const blank = Object.fromEntries(schemaFields.map((f) => [f, '']));
    setEditingItem(null);
    setFormData(blank);
    setShowForm(true);
  };

  const openEdit = (item) => {
    setEditingItem(item);
    setFormData({ ...item });
    setShowForm(true);
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    if (!api) return;
    try {
      if (editingItem) {
        const updated = await api.update(editingItem.id, formData);
        setItems((prev) => prev.map((i) => (i.id === updated.id ? updated : i)));
      } else {
        const created = await api.create(formData);
        setItems((prev) => [...prev, created]);
      }
      setShowForm(false);
    } catch (err) {
      setError(err?.message ?? 'Error guardando');
    }
  };

  const handleDelete = async (id) => {
    if (!api || !window.confirm('¿Eliminar este registro?')) return;
    try {
      await api.remove(id);
      setItems((prev) => prev.filter((i) => i.id !== id));
    } catch (err) {
      setError(err?.message ?? 'Error eliminando');
    }
  };
{% endif %}
{% endif %}

  return (
    <div className="module-page">
      <div className="page-header">
        <span className="eyebrow">{{ project_title }}</span>
        <h2>{meta.label}</h2>
{% if has_backend and modules and experience_mode == "admin" %}
        <button className="btn-primary" onClick={openCreate}>+ Nuevo</button>
{% endif %}
      </div>

{% if has_backend and modules %}
{% if admin_style == "business" %}
      <div className="kpi-bar">
        <div className="kpi-card">
          <span className="kpi-value">{items.length}</span>
          <span className="kpi-label">Total {meta.label}</span>
        </div>
      </div>
{% endif %}

      {loading && <p className="state-loading">Cargando…</p>}
      {error && <p className="state-error">{error}</p>}

      {!loading && !error && (
        <section className="module-surface" aria-label={meta.label}>
          {items.length === 0 ? (
            <p className="empty-hint">
              No hay registros aún.{% if experience_mode == "admin" %} Usa &quot;+ Nuevo&quot; para agregar el primero.{% endif %}
            </p>
          ) : (
            <div className="table-wrapper">
              <table className="data-table">
                <thead>
                  <tr>
                    {Object.keys(items[0]).filter((k) => k !== 'id').map((col) => (
                      <th key={col}>{col}</th>
                    ))}
{% if experience_mode == "admin" %}
                    <th aria-label="acciones" />
{% endif %}
                  </tr>
                </thead>
                <tbody>
                  {items.map((item) => (
                    <tr key={item.id}>
                      {Object.entries(item)
                        .filter(([k]) => k !== 'id')
                        .map(([k, v]) => (
                          <td key={k}>{v == null ? '—' : String(v)}</td>
                        ))}
{% if experience_mode == "admin" %}
                      <td className="row-actions">
                        <button className="btn-ghost" onClick={() => openEdit(item)}>Editar</button>
                        <button className="btn-danger" onClick={() => handleDelete(item.id)}>Eliminar</button>
                      </td>
{% endif %}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      )}

{% if experience_mode == "admin" %}
      {showForm && (
        <div className="modal-overlay" role="dialog" aria-modal="true" aria-label={`${editingItem ? 'Editar' : 'Nuevo'} ${meta.label}`}>
          <div className="modal">
            <h3>{editingItem ? 'Editar' : 'Nuevo'} {meta.label}</h3>
            <form onSubmit={handleSubmit}>
              {Object.keys(formData)
                .filter((k) => k !== 'id')
                .map((field) => (
                  <label key={field} className="form-field">
                    <span>{field}</span>
                    <input
                      value={formData[field] ?? ''}
                      onChange={(e) =>
                        setFormData((prev) => ({ ...prev, [field]: e.target.value }))
                      }
                    />
                  </label>
                ))}
              <div className="modal-actions">
                <button type="submit" className="btn-primary">
                  {editingItem ? 'Guardar cambios' : 'Crear'}
                </button>
                <button type="button" className="btn-ghost" onClick={() => setShowForm(false)}>
                  Cancelar
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
{% endif %}

{% else %}
      <section className="module-surface" aria-label={meta.label}>
        <p className="empty-hint">Área lista para implementar la lógica de {meta.label}.</p>
      </section>
{% endif %}
    </div>
  );
}
