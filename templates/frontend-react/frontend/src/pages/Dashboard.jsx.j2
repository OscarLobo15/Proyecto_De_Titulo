import { Activity, Layers{% if include_services %}, Server{% endif %} } from 'lucide-react';
import { useEffect, useState } from 'react';
import { Link } from 'react-router-dom';
{% if has_backend and modules %}
import {
  getHealth,
{% for module in modules %}
{% set camel = module.slug.split('-') | map('capitalize') | join('') %}
  get{{ camel }}Items,
{% endfor %}
} from '../services/api.js';
{% elif has_backend %}
import { getHealth } from '../services/api.js';
{% endif %}

{% if has_backend and modules %}
const MODULE_LOADERS = {
{% for module in modules %}
{% set camel = module.slug.split('-') | map('capitalize') | join('') %}
  '{{ module.slug }}': get{{ camel }}Items,
{% endfor %}
};
{% endif %}

const MODULES = {{ modules | tojson }};
const ROLES = {{ role_labels | tojson }};

export function Dashboard() {
{% if has_backend %}
  const [apiStatus, setApiStatus] = useState('checking');
{% endif %}
{% if has_backend and modules %}
  const [counts, setCounts] = useState({});
  const [totalItems, setTotalItems] = useState(0);
{% endif %}

  useEffect(() => {
{% if has_backend %}
    getHealth()
      .then((r) => setApiStatus(r.status ?? 'ok'))
      .catch(() => setApiStatus('offline'));
{% endif %}
{% if has_backend and modules %}
    const slugs = MODULES.map((m) => m.slug);
    Promise.allSettled(slugs.map((slug) => MODULE_LOADERS[slug]())).then((results) => {
      const next = {};
      let total = 0;
      results.forEach((r, i) => {
        const n = r.status === 'fulfilled' ? r.value.length : 0;
        next[slugs[i]] = r.status === 'fulfilled' ? n : '—';
        total += n;
      });
      setCounts(next);
      setTotalItems(total);
    });
{% endif %}
  }, []);

  return (
    <div className="page-stack">
      <div className="page-header">
        <span className="eyebrow">{{ project_profile }}</span>
        <h2>{{ "Panel admin" if experience_mode == "admin" else "Resumen" }}</h2>
        <p>Vista general del estado del sistema y los módulos activos.</p>
      </div>

      <div className="metrics-grid">
{% if has_backend %}
        <div className="card">
          <Activity size={20} className="card-icon" />
          <span className="card-label">Estado API</span>
          <strong className="card-value">{apiStatus}</strong>
        </div>
{% endif %}
        <div className="card">
          <Layers size={20} className="card-icon" />
          <span className="card-label">Módulos activos</span>
          <strong className="card-value">{{ modules | length }}</strong>
        </div>
{% if has_backend and modules %}
        <div className="card">
          <Layers size={20} className="card-icon" />
          <span className="card-label">Total registros</span>
          <strong className="card-value">{totalItems}</strong>
        </div>
{% endif %}
{% if include_services %}
        <div className="card">
          <Server size={20} className="card-icon" />
          <span className="card-label">Servicios</span>
          <strong className="card-value">{{ service_count }}</strong>
        </div>
{% endif %}
        <div className="card">
          <Activity size={20} className="card-icon" />
          <span className="card-label">Roles</span>
          <strong className="card-value">{ROLES.length}</strong>
        </div>
      </div>

{% if admin_style == "business" %}
      <section className="module-grid" aria-label="Módulos">
        {MODULES.map((m) => (
          <article className="module-card" key={m.slug}>
            <Layers size={18} className="card-icon" />
            <h3>{m.label}</h3>
{% if has_backend %}
            <p className="kpi-value">{counts[m.slug] ?? '…'} registros</p>
{% endif %}
            <Link to={`/app/module/${m.slug}`} className="btn-ghost">Ver módulo</Link>
          </article>
        ))}
      </section>
{% else %}
      <section aria-label="Módulos">
        <table className="data-table">
          <thead>
            <tr>
              <th>Módulo</th>
{% if has_backend %}
              <th>Registros</th>
{% endif %}
              <th aria-label="acciones" />
            </tr>
          </thead>
          <tbody>
            {MODULES.map((m) => (
              <tr key={m.slug}>
                <td>{m.label}</td>
{% if has_backend %}
                <td>{counts[m.slug] ?? '…'}</td>
{% endif %}
                <td className="row-actions">
                  <Link to={`/app/module/${m.slug}`} className="btn-ghost">Ver módulo</Link>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
{% endif %}
    </div>
  );
}
