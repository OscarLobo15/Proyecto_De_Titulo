import { Activity, Database, Layers, Server } from 'lucide-react';
import { useEffect, useState } from 'react';
{% if has_backend %}
import { getHealth } from '../services/api.js';
{% endif %}

export function Dashboard() {
  const modules = {{ modules | tojson }};
  const roles = {{ role_labels | tojson }};
  const [apiStatus, setApiStatus] = useState('checking');

  useEffect(() => {
{% if has_backend %}
    getHealth()
      .then((response) => setApiStatus(response.status))
      .catch(() => setApiStatus('offline'));
{% else %}
    setApiStatus('frontend-only');
{% endif %}
  }, []);

  return (
    <div className="page-stack">
      <div className="page-header">
        <span className="eyebrow">{{ project_profile }} · {{ "admin directo" if experience_mode == "admin" else "portal + admin" }} · {{ "operations workspace" if admin_style == "operations" else "business control" }}</span>
        <h2>{{ "Panel admin" if experience_mode == "admin" else "Administración" }}</h2>
        <p>Resumen visible de la arquitectura seleccionada, la navegación definida y el estado base del MVP generado.</p>
      </div>
      <div className="metrics-grid">
        <div className="card">
          <Activity size={20} className="card-icon" />
          <span className="card-label">Estado API</span>
          <strong className="card-value">{apiStatus}</strong>
        </div>
{% if has_backend %}
        <div className="card">
          <Server size={20} className="card-icon" />
          <span className="card-label">Backend</span>
          <strong className="card-value">{{ project.backend }}</strong>
        </div>
        <div className="card">
          <Database size={20} className="card-icon" />
          <span className="card-label">Base de datos</span>
          <strong className="card-value">{{ project.database }}</strong>
        </div>
{% endif %}
        <div className="card">
          <Layers size={20} className="card-icon" />
          <span className="card-label">Módulos</span>
          <strong className="card-value">{modules.length}</strong>
        </div>
{% if include_services %}
        <div className="card">
          <Server size={20} className="card-icon" />
          <span className="card-label">Servicios</span>
          <strong className="card-value">{{ service_count }}</strong>
        </div>
{% endif %}
        <div className="card">
          <Activity size={20} className="card-icon" />
          <span className="card-label">Roles</span>
          <strong className="card-value">{roles.length}</strong>
        </div>
      </div>

      <section className="module-grid">
        {modules.map((module) => (
          <article className="module-card" key={module.slug}>
            <Layers size={18} className="card-icon" />
            <span>{module.slug}</span>
            <h3>{module.label}</h3>
            <p>Visible porque fue incluido en la configuración inicial del proyecto.</p>
          </article>
        ))}
      </section>
    </div>
  );
}
