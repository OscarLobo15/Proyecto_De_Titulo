{% if uses_firebase %}
import { onAuthStateChanged, signInWithEmailAndPassword, signOut } from 'firebase/auth';
import { auth } from '../config/firebase.js';

const STORAGE_KEY = '{{ project_name }}:dev-user';

export function watchAuthState(callback) {
  if (!auth) {
    const stored = window.localStorage.getItem(STORAGE_KEY);
    callback(stored ? JSON.parse(stored) : null);
    return () => {};
  }
  return onAuthStateChanged(auth, callback);
}

export async function loginWithEmail(email, password) {
  if (!auth) {
    const user = { email, displayName: email.split('@')[0] };
    window.localStorage.setItem(STORAGE_KEY, JSON.stringify(user));
    return user;
  }
  const credential = await signInWithEmailAndPassword(auth, email, password);
  return credential.user;
}

export async function logoutUser() {
  if (!auth) {
    window.localStorage.removeItem(STORAGE_KEY);
    return;
  }
  await signOut(auth);
}
{% elif project.auth == "supabase" %}
import { supabase } from '../config/supabase.js';

const STORAGE_KEY = '{{ project_name }}:supabase-dev-user';

export function watchAuthState(callback) {
  if (!supabase) {
    const stored = window.localStorage.getItem(STORAGE_KEY);
    callback(stored ? JSON.parse(stored) : null);
    return () => {};
  }
  supabase.auth.getUser().then(({ data }) => callback(data.user));
  const { data } = supabase.auth.onAuthStateChange((_event, session) => callback(session?.user || null));
  return () => data.subscription.unsubscribe();
}

export async function loginWithEmail(email, password) {
  if (!supabase) {
    const user = { email, displayName: email.split('@')[0] };
    window.localStorage.setItem(STORAGE_KEY, JSON.stringify(user));
    return user;
  }
  const { data, error } = await supabase.auth.signInWithPassword({ email, password });
  if (error) throw error;
  return data.user;
}

export async function logoutUser() {
  if (!supabase) {
    window.localStorage.removeItem(STORAGE_KEY);
    return;
  }
  await supabase.auth.signOut();
}
{% else %}
const STORAGE_KEY = '{{ project_name }}:user';

export function watchAuthState(callback) {
  const stored = window.localStorage.getItem(STORAGE_KEY);
  callback(stored ? JSON.parse(stored) : null);
  return () => {};
}

export async function loginWithEmail(email) {
  const user = { email, displayName: email.split('@')[0] };
  window.localStorage.setItem(STORAGE_KEY, JSON.stringify(user));
  return user;
}

export async function logoutUser() {
  window.localStorage.removeItem(STORAGE_KEY);
}
{% endif %}
