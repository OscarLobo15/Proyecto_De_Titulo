:root {
  /* IBM Carbon — Neutral */
  --bg: #f4f4f4;
  --surface: #ffffff;
  --surface-muted: #e8e8e8;
  --text: #161616;
  --muted: #525252;
  --line: #e0e0e0;
  --line-strong: #8d8d8d;

  /* IBM Carbon — Interactive */
  --primary: #0f62fe;
  --primary-hover: #0353e9;
  --primary-dark: #0043ce;
  --accent: #24a148;
  --danger: #da1e28;
  --warning: #f1c21b;

  /* Sidebar (IBM Gray 100) */
  --sidebar-bg: #161616;
  --sidebar-text: #c6c6c6;
  --sidebar-border: #393939;
}

